# 서버의 deploy/.env.prod 로 복사해 값을 채운다. 이 파일(.env.prod)은 커밋하지 않는다.
PUBLIC_URL=https://c-monitor.example.com
# 구글 클라우드 콘솔 > OAuth 클라이언트(웹 애플리케이션)
# 승인된 리디렉션 URI: https://c-monitor.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -hex 32
# 텔레그램 봇 토큰은 환경변수가 아니라 관리 화면(관리 › 알림)에서 넣는다. DB에는 이 값에서 만든 키로 암호화해 저장하므로,
# SESSION_SECRET을 바꾸면 봇 토큰을 관리 화면에서 다시 넣어야 한다.
SESSION_SECRET=
# 자동으로 승인되고 관리자가 되는 Gmail 주소(쉼표로 구분)
ADMIN_EMAILS=
# openssl rand -hex 24
POSTGRES_PASSWORD=
